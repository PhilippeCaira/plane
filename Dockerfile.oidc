# Plane v1.3.0 + Zitadel OIDC provider
# Fork PhilippeCaira/plane branch oidc — ajoute le provider Zitadel (backend + frontend)
ARG PLANE_VERSION=v1.3.0

# ── Backend : patch Python files into stock plane-backend image ────
FROM makeplane/plane-backend:${PLANE_VERSION} AS plane-backend-oidc
ARG PLANE_VERSION
USER root
COPY apps/api/plane/authentication/provider/oauth/zitadel.py /code/plane/authentication/provider/oauth/zitadel.py
COPY apps/api/plane/authentication/views/app/zitadel.py /code/plane/authentication/views/app/zitadel.py
COPY apps/api/plane/authentication/views/__init__.py /code/plane/authentication/views/__init__.py
COPY apps/api/plane/authentication/urls.py /code/plane/authentication/urls.py

# ── Frontend : rebuild Vite avec bouton Zitadel ────────────────────
FROM node:22-alpine AS web-builder
ARG PLANE_VERSION
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV NEXT_TELEMETRY_DISABLED=1
ENV TURBO_TELEMETRY_DISABLED=1
RUN apk add --no-cache libc6-compat git python3 make g++ ca-certificates && corepack enable
WORKDIR /
RUN git clone --depth 1 --branch "${PLANE_VERSION}" https://github.com/makeplane/plane.git /build
WORKDIR /build
COPY apps/web/core/hooks/oauth/core.tsx apps/web/core/hooks/oauth/core.tsx
RUN pnpm install --frozen-lockfile && pnpm turbo run build --filter=web

FROM nginx:1.27-alpine AS plane-frontend-oidc
ARG PLANE_VERSION
COPY --from=web-builder /build/apps/web/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=web-builder /build/apps/web/build/client /usr/share/nginx/html
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3000/ >/dev/null || exit 1
CMD ["nginx", "-g", "daemon off;"]
